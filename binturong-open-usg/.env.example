# Database connection string
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:55322/postgres

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Optional private official-file storage. Server-only; never use NEXT_PUBLIC_ keys.
# Leave unset until the private bucket and storage slice have been verified.
OFFICIAL_STORAGE_URL=
OFFICIAL_STORAGE_BUCKET=official-documents
OFFICIAL_STORAGE_SERVICE_KEY=

# Optional cloud storage for Media (images) through an S3-compatible endpoint, such as
# Supabase Storage: https://<project-ref>.storage.supabase.co/storage/v1/s3 and the project's
# region. Server-only; never use NEXT_PUBLIC_ keys. Set all five or none: with none set,
# Media stays on local disk (public/media); a partial set stops the app from starting.
# S3 access keys reach every bucket in the project, including private ones; keep them secret.
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
